---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostLayout from "../layouts/PostLayout.astro";

let posts = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
}).catch(() => []);

posts = posts.filter((post) => (import.meta.env.PROD ? !post.data?.draft : true));

posts = posts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate || a.data.date || 0);
  const dateB = new Date(b.data.pubDate || b.data.date || 0);
  return dateB.valueOf() - dateA.valueOf();
});

const latestPost = posts[0];
const { Content } = latestPost ? await render(latestPost) : { Content: null };
---

{latestPost && Content ? (
  <PostLayout frontmatter={latestPost.data}>
    <Content />
  </PostLayout>
) : (
  <BaseLayout pageTitle="Welcome to Beverage Story">
    <div style="font-family: sans-serif; text-align: center; margin-top: 20vh;">
      <h1>Welcome to your new blog!</h1>
      <p>No posts were found. Add markdown posts to <code>src/content/posts</code> to get started.</p>
    </div>
  </BaseLayout>
)}

