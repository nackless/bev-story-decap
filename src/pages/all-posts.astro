---
import { getCollection } from "astro:content";
import Baselayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
const pageTitle = "All Posts";
import dateFormat from "../utils/dateFormat";

// const allPosts = await Astro.glob("./posts/*.md"); - deprecated

// get posts from getCollections
const posts = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// sort the blog posts from newest to oldest (descending order)
posts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate || a.data.date || 0);
  const dateB = new Date(b.data.pubDate || b.data.date || 0);
  return dateB.valueOf() - dateA.valueOf();
});
---

<Baselayout pageTitle={pageTitle}>
  {
    posts.map((post) => {
      const urlSlug = post.data?.slug || post.slug || post.id;
      const displayTitle = post.data?.title || urlSlug;
      return (
        <PostCard
          url={`/posts/${urlSlug}/`}
          title={displayTitle}
          date={post.data?.pubDate ? dateFormat(post.data.pubDate) : ""}
          description={post.data?.description || ""}
        />
      );
    })
  }
</Baselayout>
