---
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  image: string;
  alt?: string;
  caption?: string;
  width?: string;
  borderRadius?: string | number;
  aspectRatio?: string;
  gap?: string;
  optimized?: boolean;
}

const {
  image,
  alt = "",
  caption,
  width = "45%",
  borderRadius = "8px",
  aspectRatio,
  gap = "1.5rem",
  optimized = false,
} = Astro.props;

const formattedRadius = typeof borderRadius === "number" ? `${borderRadius}px` : borderRadius;
const resolvedAlt = alt || caption || "Blog image";
---

<div class="media-text-right" style={`gap: ${gap};`}>
  <div class="text-col">
    <slot />
  </div>

  <div 
    class="media-col" 
    style={`flex-basis: ${width}; max-width: ${width};`}
  >
    <div 
      class="img-wrapper" 
      style={`border-radius: ${formattedRadius}; ${aspectRatio ? `aspect-ratio: ${aspectRatio};` : ""}`}
    >
      {optimized ? (
        <OptimizedImage
          src={image}
          alt={resolvedAlt}
          width={800}
          height={800}
          sizes="(max-width: 768px) 100vw, 35vw"
          loading="lazy"
          decoding="async"
          style={aspectRatio ? "height: 100%; object-fit: contain;" : "height: auto; object-fit: contain;"}
        />
      ) : (
        <img 
          src={image} 
          alt={resolvedAlt} 
          loading="lazy" 
          decoding="async"
          style={aspectRatio ? "width: 100%; height: 100%; object-fit: contain;" : "width: 100%; height: auto; object-fit: contain;"}
        />
      )}
    </div>
    {caption && <p class="caption">{caption}</p>}
  </div>
</div>

<style>
  .media-text-right {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    margin: 2rem 0;
    width: 100%;
  }

  .media-col {
    flex-shrink: 0;
    width: 100%;
  }

  .img-wrapper {
    overflow: hidden;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .img-wrapper img {
    width: 100%;
    max-width: 100%;
    display: block;
    height: auto;
    object-fit: contain;
    object-position: center;
  }

  .caption {
    font-size: 0.875rem;
    color: #666;
    text-align: center;
    margin-top: 0.5rem;
    font-style: italic;
  }

  .text-col {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .media-text-right {
      flex-direction: column-reverse;
    }

    .media-col {
      max-width: 100% !important;
      flex-basis: 100% !important;
    }
  }
</style>
