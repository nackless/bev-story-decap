---
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt = '',
  width = 1200,
  height = 800,
  sizes = '100vw',
  loading = 'lazy',
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  sizes={sizes}
  loading={loading}
/>
