---
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  style?: string;
  objectFit?: 'contain' | 'cover' | 'fill' | 'none' | 'scale-down';
}

const {
  src,
  alt = '',
  width = 1200,
  height = 800,
  sizes = '100vw',
  loading = 'lazy',
  class: className,
  style,
  objectFit = 'contain',
} = Astro.props;

const resolvedStyle = [
  'display: block;',
  'width: 100%;',
  'height: auto;',
  `object-fit: ${objectFit};`,
  'object-position: center;',
  style,
].filter(Boolean).join(' ');
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  sizes={sizes}
  loading={loading}
  class={className}
  style={resolvedStyle}
/>
