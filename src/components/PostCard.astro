---
import { cleanDescription } from '../utils/cleanDescription.js';

const { url, title, date, description } = Astro.props;
const sanitizedDescription = cleanDescription(description);
---

<a class="blog-card" href={url}>
  <div>
    <h3 class="title">{title}</h3>
    <p class="date">{date}</p>
    {sanitizedDescription && (
      <p class="description">
        {sanitizedDescription}
      </p>
    )}
  </div>
</a>

<style>
  .title {
    padding-top: 1.5rem;
    font-weight: var(--fw-medium);
    font-size: 1.5rem;
    text-align: center;
  }
</style>
